<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS uniquement : tout trafic en clair est refusé, y compris en debug. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
